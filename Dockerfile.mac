FROM python:3.12-slim

ARG TORCH_VERSION=2.6.0
ARG TORCHVISION_VERSION=0.21.0
ARG ULTRALYTICS_VERSION=8.3.237

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libkrb5-dev \
    libgl1 \
    git \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV PYTHONPATH=/app \
    PIP_DISABLE_PIP_VERSION_CHECK=1

COPY wait-for-it.sh /wait-for-it.sh
RUN chmod +x /wait-for-it.sh

COPY requirements.txt .

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu \
        "torch==${TORCH_VERSION}" \
        "torchvision==${TORCHVISION_VERSION}" && \
    pip install --no-cache-dir \
        numpy \
        matplotlib \
        opencv-python \
        pillow \
        pyyaml \
        requests \
        scipy \
        tqdm \
        psutil \
        py-cpuinfo \
        pandas \
        seaborn \
        ultralytics-thop && \
    sed -E '/^[[:space:]]*(torch|torchvision|torchaudio|triton|ultralytics)([<>=~! ]|$)/d' requirements.txt > /tmp/requirements-base.txt && \
    PIP_NO_DEPS=1 pip install --no-cache-dir -r /tmp/requirements-base.txt && \
    pip install --no-cache-dir --no-deps "ultralytics==${ULTRALYTICS_VERSION}" && \
    python -c "import torch, torchvision, ultralytics; print('torch', torch.__version__, 'cuda', torch.version.cuda); print('torchvision', torchvision.__version__); print('ultralytics', ultralytics.__version__); assert torch.version.cuda is None"

COPY . .